@using Web.ViewModel
@model InstructorViewModel
@{
    var selectItems = new SelectList(Model.itemList, "Id", "Name");
    var courses = Model.itemList;
}

@if (courses != null && courses.Any())
{
    <div class="dept-courses-container">
        <!-- Header Section -->
        <div class="dept-courses-header">
            <div class="header-icon-wrapper">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <div class="header-text-wrapper">
                <h3 class="dept-courses-title">Available Courses</h3>
                <p class="dept-courses-subtitle">Select a course to assign to this instructor</p>
            </div>
            <div class="course-count-badge">
                <i class="fa-solid fa-layer-group"></i>
                <span>@courses.Count Course@(courses.Count != 1 ? "s" : "")</span>
            </div>
        </div>
        
        <!-- Course Selection Dropdown -->
        <div class="course-selector-wrapper">
            <label for="CourseId" class="selector-label">
                <i class="fa-solid fa-circle-check"></i>
                <span>Select Course</span>
            </label>
            <div class="select-input-wrapper">
                <select asp-for="CourseId" asp-items="selectItems" class="course-select-modern" id="CourseId">
                    <option value="-1">Choose a course from the list below</option>
                </select>
                <i class="fa-solid fa-chevron-down select-chevron"></i>
            </div>
        </div>
        
        <!-- Course Cards Grid -->
        <div class="dept-courses-grid">
            @foreach (var course in courses)
            {
                <div class="dept-course-card">
                    <div class="dept-course-card-header">
                        <div class="dept-course-icon-badge">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <h4 class="dept-course-name">@course.Name</h4>
                    </div>
                    <div class="dept-course-card-body">
                        <div class="dept-course-degrees">
                            <div class="dept-degree-item">
                                <i class="fa-solid fa-arrow-trend-up degree-icon"></i>
                                <div class="degree-content">
                                    <span class="degree-label">Max Degree</span>
                                    <span class="degree-value max">@course.Degree</span>
                                </div>
                            </div>
                            <div class="degree-divider"></div>
                            <div class="dept-degree-item">
                                <i class="fa-solid fa-arrow-trend-down degree-icon"></i>
                                <div class="degree-content">
                                    <span class="degree-label">Min Degree</span>
                                    <span class="degree-value min">@course.MinDegree</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="no-courses-state">
        <div class="no-courses-icon">
            <i class="fa-solid fa-inbox"></i>
        </div>
        <h4 class="no-courses-title">No Courses Available</h4>
        <p class="no-courses-text">There are currently no courses in this department.</p>
    </div>
}