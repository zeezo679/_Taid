@model Web.ViewModel.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<!-- Dashboard Page -->
<div class="dashboard-page">
    
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-text">
                <h1 class="dashboard-title">
                    <i data-feather="activity" class="title-icon"></i>
                    Dashboard Overview
                </h1>
                <p class="dashboard-subtitle">Monitor your platform's key metrics and performance</p>
            </div>
            <div class="header-actions">
                <span class="last-updated">
                    <i data-feather="clock" class="update-icon"></i>
                    Updated just now
                </span>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Grid -->
    <div class="stats-grid">
        <!-- Total Courses Card -->
        <div class="stat-card stat-card-blue">
            <div class="stat-card-inner">
                <div class="stat-icon-wrapper">
                    <div class="stat-icon">
                        <i data-feather="book-open"></i>
                    </div>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Courses</p>
                    <h3 class="stat-value">@Model.TotalCourses</h3>
                    <p class="stat-description">Active courses available</p>
                </div>
            </div>
            <div class="stat-card-decoration"></div>
        </div>

        <!-- Total Instructors Card -->
        <div class="stat-card stat-card-purple">
            <div class="stat-card-inner">
                <div class="stat-icon-wrapper">
                    <div class="stat-icon">
                        <i data-feather="users"></i>
                    </div>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Instructors</p>
                    <h3 class="stat-value">@Model.TotalInstructors</h3>
                    <p class="stat-description">Teaching professionals</p>
                </div>
            </div>
            <div class="stat-card-decoration"></div>
        </div>

        <!-- Total Trainees Card -->
        <div class="stat-card stat-card-green">
            <div class="stat-card-inner">
                <div class="stat-icon-wrapper">
                    <div class="stat-icon">
                        <i data-feather="user-check"></i>
                    </div>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Trainees</p>
                    <h3 class="stat-value">@Model.TotalTrainees</h3>
                    <p class="stat-description">Active learners</p>
                </div>
            </div>
            <div class="stat-card-decoration"></div>
        </div>

        <!-- Total Departments Card -->
        <div class="stat-card stat-card-orange">
            <div class="stat-card-inner">
                <div class="stat-icon-wrapper">
                    <div class="stat-icon">
                        <i data-feather="briefcase"></i>
                    </div>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Departments</p>
                    <h3 class="stat-value">@Model.TotalDepartments</h3>
                    <p class="stat-description">Academic divisions</p>
                </div>
            </div>
            <div class="stat-card-decoration"></div>
        </div>

        <!-- Total Enrollments Card -->
        <div class="stat-card stat-card-pink">
            <div class="stat-card-inner">
                <div class="stat-icon-wrapper">
                    <div class="stat-icon">
                        <i data-feather="trending-up"></i>
                    </div>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Enrollments</p>
                    <h3 class="stat-value">@Model.TotalEnrollements</h3>
                    <p class="stat-description">Course registrations</p>
                </div>
            </div>
            <div class="stat-card-decoration"></div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
        
        <!-- Course Distribution Chart -->
        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-header-content">
                    <h2 class="chart-title">
                        <i data-feather="pie-chart" class="chart-title-icon"></i>
                        Course Distribution by Department
                    </h2>
                    <p class="chart-subtitle">Breakdown of courses across all departments</p>
                </div>
            </div>
            <div class="chart-card-body">
                @if (Model.CoursesByDept != null && Model.CoursesByDept.Any())
                {
                    <div class="chart-container">
                        <canvas id="coursesChart" class="pie-chart"></canvas>
                    </div>
                    
                    <!-- Legend -->
                    <div class="chart-legend" id="chartLegend">
                        @foreach (var dept in Model.CoursesByDept)
                        {
                            <div class="legend-item">
                                <span class="legend-color"></span>
                                <span class="legend-label">@dept.DeptName</span>
                                <span class="legend-value">@dept.CourseCount courses</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="chart-empty-state">
                        <i data-feather="inbox" class="empty-icon"></i>
                        <p class="empty-text">No data available</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Recent Activities Section -->
    <div class="activities-section">
        
        <!-- Recently Added Courses -->
        <div class="activity-card">
            <div class="activity-card-header">
                <h2 class="activity-title">
                    <i data-feather="plus-circle" class="activity-icon"></i>
                    Recently Added Courses
                </h2>
            </div>
            <div class="activity-card-body">
                @if (Model.RecentAddedCourses != null && Model.RecentAddedCourses.Any())
                {
                    <div class="activity-list">
                        @foreach (var course in Model.RecentAddedCourses.Take(5))
                        {
                            <div class="activity-item">
                                <div class="activity-item-icon">
                                    <i data-feather="book"></i>
                                </div>
                                <div class="activity-item-content">
                                    <h4 class="activity-item-title">@course.Name</h4>
                                    <p class="activity-item-meta">
                                        <i data-feather="user" class="meta-icon"></i>
                                        @(course.Instructors?.FirstOrDefault()?.Name ?? "No instructor")
                                        <span class="meta-separator">•</span>
                                        <i data-feather="folder" class="meta-icon"></i>
                                        @course.Department?.Name
                                    </p>
                                </div>
                                <div class="activity-item-action">
                                    <a asp-controller="Course" asp-action="ViewCourseDetails" asp-route-id="@course.Id" 
                                       class="view-btn">
                                        <span>View</span>
                                        <i data-feather="arrow-right" class="btn-arrow"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="activity-empty-state">
                        <i data-feather="inbox" class="empty-icon"></i>
                        <p class="empty-text">No recent courses</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Enrollments -->
        <div class="activity-card">
            <div class="activity-card-header">
                <h2 class="activity-title">
                    <i data-feather="user-plus" class="activity-icon"></i>
                    Recent Enrollments
                </h2>
            </div>
            <div class="activity-card-body">
                @if (Model.RecentEnrollements != null && Model.RecentEnrollements.Any())
                {
                    <div class="activity-list">
                        @foreach (var course in Model.RecentEnrollements.Take(5))
                        {
                            <div class="activity-item">
                                <div class="activity-item-icon">
                                    <i data-feather="check-circle"></i>
                                </div>
                                <div class="activity-item-content">
                                    <h4 class="activity-item-title">@course.Name</h4>
                                    <p class="activity-item-meta">
                                        <i data-feather="user" class="meta-icon"></i>
                                        @(course.Instructors?.FirstOrDefault()?.Name ?? "No instructor")
                                        <span class="meta-separator">•</span>
                                        <i data-feather="folder" class="meta-icon"></i>
                                        @course.Department?.Name
                                    </p>
                                </div>
                                <div class="activity-item-action">
                                    <a asp-controller="Course" asp-action="ViewCourseDetails" asp-route-id="@course.Id" 
                                       class="view-btn">
                                        <span>View</span>
                                        <i data-feather="arrow-right" class="btn-arrow"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="activity-empty-state">
                        <i data-feather="inbox" class="empty-icon"></i>
                        <p class="empty-text">No recent enrollments</p>
                    </div>
                }
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    
    <script>
        // Initialize Feather Icons
        feather.replace();

        // Pie Chart for Course Distribution
        @if (Model.CoursesByDept != null && Model.CoursesByDept.Any())
        {
            <text>
            const ctx = document.getElementById('coursesChart');
            
            const data = {
                labels: [@Html.Raw(string.Join(",", Model.CoursesByDept.Select(d => $"'{d.DeptName}'")))],
                datasets: [{
                    label: 'Courses',
                    data: [@string.Join(",", Model.CoursesByDept.Select(d => d.CourseCount))],
                    backgroundColor: [
                        'rgba(59, 130, 246, 0.8)',   // Blue
                        'rgba(139, 92, 246, 0.8)',   // Purple
                        'rgba(16, 185, 129, 0.8)',   // Green
                        'rgba(245, 158, 11, 0.8)',   // Orange
                        'rgba(239, 68, 68, 0.8)',    // Red
                        'rgba(236, 72, 153, 0.8)',   // Pink
                        'rgba(20, 184, 166, 0.8)',   // Teal
                        'rgba(251, 146, 60, 0.8)',   // Amber
                    ],
                    borderColor: [
                        'rgba(59, 130, 246, 1)',
                        'rgba(139, 92, 246, 1)',
                        'rgba(16, 185, 129, 1)',
                        'rgba(245, 158, 11, 1)',
                        'rgba(239, 68, 68, 1)',
                        'rgba(236, 72, 153, 1)',
                        'rgba(20, 184, 166, 1)',
                        'rgba(251, 146, 60, 1)',
                    ],
                    borderWidth: 2
                }]
            };

            const config = {
                type: 'pie',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: false // Using custom legend
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += context.parsed + ' courses';
                                    return label;
                                }
                            }
                        }
                    }
                }
            };

            const coursesChart = new Chart(ctx, config);

            // Update custom legend colors
            const legendItems = document.querySelectorAll('.legend-color');
            const colors = data.datasets[0].backgroundColor;
            legendItems.forEach((item, index) => {
                item.style.backgroundColor = colors[index];
            });
            </text>
        }

        // Animate stat cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach((card, index) => {
                setTimeout(() => {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    
                    setTimeout(() => {
                        card.style.transition = 'all 0.5s ease';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, 50);
                }, index * 100);
            });
        });
    </script>
}